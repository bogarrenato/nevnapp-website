---
/**
 * BaseLayout — the only top-level wrapper. Every page reuses it.
 *
 * Responsibilities:
 *  - <head> meta tags (description, OG, Twitter, canonical, hreflang)
 *  - Structured data (JSON-LD) — caller passes optional `jsonLd` prop
 *  - Theme + colour-scheme bootstrap (prevents FOUC by reading localStorage
 *    BEFORE the body renders)
 *  - Slots for header / page content / footer
 */
// Self-hosted variable fonts (latin + latin-ext for ő/ű): no third-party font request.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '../styles/global.css';
import { strings, SITE_URL, type Lang } from '../i18n/strings';
import CookieBanner from '../components/CookieBanner.astro';
import { STORE_LINKS, SOCIAL } from '../lib/constants';
import { CREATOR_NAME, buildIdentityGraph } from '../lib/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StoreBadge from '../components/StoreBadge.astro';
import DownloadSheet from '../components/DownloadSheet.astro';

interface Props {
  lang?: Lang;
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  /** Optional alternate language path so we can emit hreflang. */
  altLangPath?: string;
  /** Optional JSON-LD payload(s) for schema.org markup. */
  jsonLd?: object | object[];
  /** Explicit robots directives. Defaults to full snippet eligibility. */
  robots?: string;
  /** Accessible alt text for the social image. */
  ogImageAlt?: string;
  /** Hides the global app-download CTA strip when set (e.g. on legal pages). */
  hideDownloadStrip?: boolean;
  /** Loads AdSense only on substantial publisher-content pages. */
  adsEligible?: boolean;
}

const {
  lang = 'hu',
  title,
  description,
  canonical,
  ogImage = '/og-default.png',
  altLangPath,
  jsonLd,
  robots = 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1',
  ogImageAlt,
  hideDownloadStrip = false,
  adsEligible = false,
} = Astro.props;

const t = strings[lang];
const metaDescription = description ?? t.description;
const url = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageUrl = new URL(ogImage, SITE_URL).toString();
const imageAlt = ogImageAlt ?? `${t.brand} — modern magyar névnap-naptár`;
const defaultLanguageUrl = altLangPath ? new URL(altLangPath, SITE_URL).toString() : null;

const jsonLdEntries = jsonLd
  ? [buildIdentityGraph(lang), ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : [buildIdentityGraph(lang)];
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'hu'} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafd" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#08080f" />

    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="bingbot" content={robots} />
    <meta name="author" content={CREATOR_NAME} />
    <meta name="publisher" content={t.brand} />
    <meta name="application-name" content={t.brand} />
    <meta name="apple-mobile-web-app-title" content={t.brand} />
    {import.meta.env.PROD && <meta name="google-adsense-account" content="ca-pub-5975990857512539" />}
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={url} />
    <link rel="alternate" type="text/plain" href={new URL('/llms.txt', SITE_URL).toString()} title="LLM summary" />
    <link rel="alternate" type="text/plain" href={new URL('/llms-full.txt', SITE_URL).toString()} title="LLM full context" />
    <link rel="me" href={SOCIAL.instagram} />
    <link rel="me" href={SOCIAL.tiktok} />

    <!-- hreflang alternates -->
    {altLangPath && lang === 'hu' && (
      <link rel="alternate" hreflang="en" href={new URL(`/en${altLangPath}`, SITE_URL).toString()} />
    )}
    {altLangPath && lang === 'en' && (
      <link rel="alternate" hreflang="hu" href={new URL(altLangPath, SITE_URL).toString()} />
    )}
    {defaultLanguageUrl && <link rel="alternate" hreflang="x-default" href={defaultLanguageUrl} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'hu_HU'} />
    {altLangPath && <meta property="og:locale:alternate" content={lang === 'en' ? 'hu_HU' : 'en_US'} />}
    <meta property="og:site_name" content={t.brand} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Favicon / icon -->
    <link rel="icon" type="image/png" href="/icons/app-icon.png" />
    <link rel="apple-touch-icon" href="/icons/app-icon.png" />

    <!-- Theme bootstrap (no FOUC). Dark is the default; a saved choice wins.
         `js` enables the scroll-reveal styles; `reveal-all` is the safety net
         that shows everything if the reveal script never runs. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = 'dark';
        try { theme = localStorage.getItem('nevnap-theme') || 'dark'; } catch (_) {}
        if (theme === 'dark') root.classList.add('dark');
        root.classList.add('js');
        setTimeout(function () { if (!root.hasAttribute('data-reveal-ready')) root.classList.add('reveal-all'); }, 2500);
      })();
    </script>

    {jsonLdEntries.map((entry) => (
      <script is:inline type="application/ld+json" data-schema-type={(entry as Record<string, unknown>)['@type']} set:html={JSON.stringify(entry)} />
    ))}

  <!-- Google Analytics GA4 — csak prod + felhasználói consent után -->
  {import.meta.env.PROD && (
    <>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        // Basic Consent Mode: no Analytics network request is made before an
        // explicit analytics choice. Ad consent is handled by the certified CMP.
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 500
        });
        var analyticsLoaded = false;
        function loadAnalytics() {
          if (analyticsLoaded) return;
          analyticsLoaded = true;
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id=G-CZKZV7GE2N';
          document.head.appendChild(script);
          gtag('js', new Date());
          gtag('config', 'G-CZKZV7GE2N', {
            anonymize_ip: true,
            cookie_flags: 'SameSite=None;Secure',
          });
        }
        function applyConsent(c) {
          if (!c) return;
          gtag('consent', 'update', {
            analytics_storage: c.analytics ? 'granted' : 'denied',
          });
          if (c.analytics) loadAnalytics();
          else if (analyticsLoaded) window.location.reload();
        }
        try { applyConsent(JSON.parse(localStorage.getItem('nevnap-consent'))); } catch (e) {}
        window.addEventListener('consent-updated', function (e) { applyConsent(e.detail); });
      </script>
      {adsEligible && (
        <script
          async
          is:inline
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5975990857512539"
          crossorigin="anonymous"
        ></script>
      )}
    </>
  )}

    <!-- Cookie consent korai check — anti-FOUC, MUST be in <head> before render -->
    <script is:inline>
      (function(){try{var c=localStorage.getItem('nevnap-consent');document.documentElement.dataset.cookieConsent=c?'given':'pending';}catch(e){document.documentElement.dataset.cookieConsent='pending';}})();
    </script>
  </head>
  <body class="font-body">
    <a href="#main" class="skip-link">
      {lang === 'hu' ? 'Ugrás a fő tartalomhoz' : 'Skip to main content'}
    </a>

    <Header lang={lang} altLangPath={altLangPath} />

    <main id="main" class="relative" tabindex="-1">
      <slot />
    </main>

    {!hideDownloadStrip && (
      <section aria-labelledby="download-heading" class="relative overflow-hidden mt-20 lg:mt-28 border-t border-nx-line">
        <div aria-hidden="true" class="absolute inset-0 pointer-events-none opacity-45" style="background: radial-gradient(ellipse 50% 70% at 50% 100%, var(--nx-glow), transparent);"></div>
        <div class="container mx-auto px-6 py-16 lg:py-24 relative flex flex-col items-center text-center gap-4">
          <img src="/icons/app-icon.png" alt="" width="72" height="72" loading="lazy" class="size-16 lg:size-[4.5rem] rounded-[1.125rem] lg:rounded-[1.25rem] shadow-[0_24px_48px_-16px_rgba(110,91,255,0.8)]" data-reveal />
          <h2 id="download-heading" class="mt-2 max-w-3xl font-extrabold text-[clamp(2rem,4.4vw,3.5rem)] leading-[1.02] tracking-[-0.035em] text-balance" data-reveal>
            {lang === 'hu'
              ? 'Töltsd le a NévnapTárX appot ingyen'
              : 'Download NévnapTárX free'}
          </h2>
          <p class="max-w-xl text-[1.0625rem] leading-relaxed text-nx-muted text-pretty" data-reveal>
            {lang === 'hu'
              ? '1300+ név napjai, több száz név jelentése és napi értesítés — egy modern app a zsebedben.'
              : 'Namedays for 1,300+ names, hundreds of name meanings and daily reminders — a modern app in your pocket.'}
          </p>
          <div class="mt-3 w-full max-w-sm sm:w-auto sm:max-w-none grid grid-cols-1 min-[22.5rem]:grid-cols-2 gap-2.5 sm:flex sm:gap-3 justify-center" role="group" aria-label={lang === 'hu' ? 'Letöltési linkek' : 'Download links'} data-reveal>
            <StoreBadge store="apple" href={STORE_LINKS.appStore} lang={lang} />
            <StoreBadge store="google" href={STORE_LINKS.playStore} lang={lang} />
          </div>
        </div>
      </section>
    )}

    {hideDownloadStrip && <div class="mt-24" aria-hidden="true"></div>}
    <Footer lang={lang} />
    <DownloadSheet lang={lang} />
    <CookieBanner lang={lang} />

    <script>
      /**
       * Scroll choreography (progressive enhancement, see global.css):
       *  - [data-reveal] fades/rises in when it enters the viewport; elements
       *    that arrive together are staggered, later ones are not delayed
       *  - [data-countup] counts up to the number it already contains
       * With reduced motion the content is simply shown.
       */
      const root = document.documentElement;
      const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealables = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));

      const countUp = (el: HTMLElement) => {
        const target = Number(el.textContent?.trim());
        if (!Number.isFinite(target) || target <= 0) return;
        const started = performance.now();
        const duration = 1400;
        const tick = (now: number) => {
          const t = Math.min(1, (now - started) / duration);
          const eased = 1 - Math.pow(1 - t, 4);
          el.textContent = String(Math.round(target * eased));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      if (calm || !('IntersectionObserver' in window)) {
        root.classList.add('reveal-all');
      } else {
        const observer = new IntersectionObserver((entries) => {
          let order = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            el.style.setProperty('--i', String(Math.min(order++, 6)));
            el.classList.add('is-in');
            el.querySelectorAll<HTMLElement>('[data-countup]').forEach(countUp);
            if (el.matches('[data-countup]')) countUp(el);
            observer.unobserve(el);
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        revealables.forEach((el) => observer.observe(el));
      }
      root.setAttribute('data-reveal-ready', '');

      /**
       * Jump bar scroll-spy (/names letters, /calendar months): highlights the
       * section being read and keeps its link visible in the scrolling row.
       */
      const jump = document.querySelector<HTMLElement>('[data-jump]');
      if (jump && 'IntersectionObserver' in window) {
        const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-jump-section]'));
        const links = new Map<string, HTMLAnchorElement>();
        jump.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => links.set(decodeURIComponent(a.hash.slice(1)), a));
        const list = jump.querySelector<HTMLElement>('ul');
        const visible = new Set<string>();
        let current = '';

        const setCurrent = (id: string) => {
          if (id === current) return;
          links.get(current)?.removeAttribute('aria-current');
          current = id;
          const link = links.get(id);
          if (!link) return;
          link.setAttribute('aria-current', 'true');
          if (list && list.scrollWidth > list.clientWidth) {
            const delta = link.getBoundingClientRect().left - list.getBoundingClientRect().left;
            list.scrollTo({ left: list.scrollLeft + delta - (list.clientWidth - link.offsetWidth) / 2, behavior: calm ? 'auto' : 'smooth' });
          }
        };
        // A thin band just below the sticky header + jump bar decides which section
        // counts as "current" (anchor jumps land a section's top at ~150px).
        const spy = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id); else visible.delete(entry.target.id);
          }
          const first = sections.find((section) => visible.has(section.id));
          if (first) setCurrent(first.id);
        }, { rootMargin: '-170px 0px -70% 0px' });
        sections.forEach((section) => spy.observe(section));
      }
    </script>
  </body>
</html>
