---
/**
 * Accessible day/night toggle: a single 44px icon button (sun ⇄ moon).
 * The header renders it twice (desktop bar + mobile menu), so everything is
 * wired by the `data-theme-toggle` attribute, never by id.
 *
 * a11y notes:
 *  - <button role="switch" aria-checked="..."> per WAI-ARIA APG pattern
 *  - aria-label describes the action; the icons are decorative (aria-hidden)
 *  - prefers-reduced-motion is honored globally via global.css
 */
import type { Lang } from '../i18n/strings';

interface Props { lang: Lang; class?: string }
const { lang, class: className = '' } = Astro.props;
const label = lang === 'hu' ? 'Sötét mód váltása' : 'Toggle dark mode';
---

<button
  type="button"
  data-theme-toggle
  role="switch"
  aria-checked="true"
  aria-label={label}
  class:list={['nx-iconbtn relative overflow-hidden', className]}
>
  <!-- Moon: shown in dark mode -->
  <svg
    class="absolute size-[1.125rem] transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] -rotate-90 scale-0 opacity-0 dark:rotate-0 dark:scale-100 dark:opacity-100"
    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true" focusable="false"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
  </svg>
  <!-- Sun: shown in light mode -->
  <svg
    class="absolute size-[1.125rem] transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] rotate-0 scale-100 opacity-100 dark:rotate-90 dark:scale-0 dark:opacity-0"
    viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true" focusable="false"
  >
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
</button>

<script>
  /**
   * Toggles .dark on <html>, persists the choice and keeps every toggle's
   * aria-checked in sync. The initial class is set by the inline bootstrap
   * script in BaseLayout, so there is no flash of the wrong theme.
   */
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => {
    const isDark = document.documentElement.classList.contains('dark');
    toggles.forEach((btn) => btn.setAttribute('aria-checked', String(isDark)));
  };
  toggles.forEach((btn) => btn.addEventListener('click', () => {
    const next = document.documentElement.classList.toggle('dark') ? 'dark' : 'light';
    try { localStorage.setItem('nevnap-theme', next); } catch (_) {}
    sync();
  }));
  sync();
</script>
