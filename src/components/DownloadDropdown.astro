---
/**
 * "Download" CTA that offers both stores.
 *
 *  - 640px and up: a popover anchored to the button. Its width is capped to the
 *    viewport and it is nudged back on screen if it would overflow.
 *  - below 640px: no floating dropdown at all — the trigger opens the shared
 *    bottom sheet (DownloadSheet.astro, rendered once by BaseLayout).
 *
 * Variants:
 *  - `variant="ghost"`   — compact pill, used in the header
 *  - `variant="primary"` — larger pill for in-page CTAs
 *  - `variant="cta"`     — full-width block CTA (name pages)
 *
 * a11y notes:
 *  - <button aria-expanded aria-controls> toggles the popover
 *  - <ul role="menu"> + <li role="none"> + <a role="menuitem">
 *  - Escape closes; click-outside closes; arrow keys move between items
 */
import { STORE_LINKS } from '../lib/constants';
import StoreIcon from './StoreIcon.astro';
import type { Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  variant?: 'primary' | 'ghost' | 'cta';
  /** Unique id so multiple instances on a page don't clash. */
  id?: string;
  /** Override the trigger text — defaults to a localized "Download" label. */
  label?: string;
  /** Which side the popover opens toward. */
  align?: 'left' | 'right';
}
const { lang, variant = 'primary', id = 'download-dd', label, align = 'left' } = Astro.props;

const triggerLabel = label ?? (lang === 'hu' ? 'Töltsd le ingyen' : 'Download free');
const menuLabel = lang === 'hu' ? 'Letöltési lehetőségek' : 'Download options';
const stores = [
  { store: 'apple', name: 'App Store', tag: lang === 'hu' ? 'iPhone és iPad' : 'iPhone & iPad', href: STORE_LINKS.appStore },
  { store: 'google', name: 'Google Play', tag: 'Android', href: STORE_LINKS.playStore },
] as const;

const triggerClass = variant === 'cta'
  ? 'nx-btn-primary w-full h-16 rounded-3xl text-lg font-bold gap-3'
  : variant === 'primary'
  ? 'nx-btn-primary h-[3.25rem] px-6 text-base'
  : 'nx-btn-primary';

const wrapperClass = variant === 'cta' ? 'relative block w-full' : 'relative inline-flex';
---

<div class={wrapperClass} data-download-dd={id} data-align={align}>
  <button
    type="button"
    id={`${id}-trigger`}
    data-download-trigger
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls={`${id}-menu`}
    class={triggerClass}
  >
    <span>{triggerLabel}</span>
    <svg
      class="size-4 transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] [[aria-expanded=true]>&]:rotate-180"
      viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
      aria-hidden="true" focusable="false"
    >
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </button>

  <div
    id={`${id}-menu`}
    data-download-menu
    role="menu"
    aria-label={menuLabel}
    hidden
    class:list={['nx-popover', align === 'right' ? 'right-0 origin-top-right' : 'left-0 origin-top-left']}
  >
    <ul class="list-none flex flex-col gap-1">
      {stores.map((s) => (
        <li role="none">
          <a role="menuitem" href={s.href} rel="noopener" class="nx-store-row">
            <span class="nx-store-row-icon"><StoreIcon store={s.store} class="size-5" /></span>
            <span class="flex-1 leading-tight">
              <span class="block text-[0.9375rem] font-semibold">{s.name}</span>
              <span class="block text-[0.8125rem] text-nx-muted">{s.tag}</span>
            </span>
            <svg class="size-4 text-nx-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  /**
   * Dropdown controller — no framework, Astro stays islands-free.
   *   - Small screens: hand over to the shared bottom sheet
   *   - Otherwise: toggle the popover, keep it inside the viewport,
   *     close on outside click / Escape, arrow keys between items
   */
  const smallScreen = window.matchMedia('(max-width: 639px)');
  const EDGE = 8; // minimum gap between popover and viewport edge, px

  function initDropdown(root: HTMLElement) {
    const trigger = root.querySelector<HTMLButtonElement>('[data-download-trigger]');
    const menu = root.querySelector<HTMLElement>('[data-download-menu]');
    if (!trigger || !menu) return;

    const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a[role="menuitem"]'));
    let closeTimer: number | undefined;
    const isOpen = () => !menu.hidden && menu.classList.contains('is-open');

    /** Shift the popover horizontally if its natural position leaves the viewport. */
    const keepOnScreen = () => {
      const anchor = root.getBoundingClientRect();
      const width = menu.offsetWidth;
      const left = root.dataset.align === 'right' ? anchor.right - width : anchor.left;
      const viewport = document.documentElement.clientWidth;
      let shift = 0;
      if (left < EDGE) shift = EDGE - left;
      else if (left + width > viewport - EDGE) shift = viewport - EDGE - (left + width);
      menu.style.setProperty('--nx-shift', `${Math.round(shift)}px`);
    };

    const open = () => {
      if (smallScreen.matches) {
        window.dispatchEvent(new CustomEvent('nx:download-sheet', { detail: { trigger } }));
        return;
      }
      window.clearTimeout(closeTimer);
      menu.hidden = false;
      keepOnScreen();
      requestAnimationFrame(() => menu.classList.add('is-open'));
      trigger.setAttribute('aria-expanded', 'true');
      items[0]?.focus({ preventScroll: true });
    };
    const close = (refocus = true) => {
      if (menu.hidden) return;
      menu.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
      closeTimer = window.setTimeout(() => { menu.hidden = true; }, 220);
      if (refocus) trigger.focus({ preventScroll: true });
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen()) close(); else open();
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) close(false);
    });
    window.addEventListener('resize', () => { if (isOpen()) keepOnScreen(); });
    smallScreen.addEventListener('change', () => close(false));

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const idx = items.indexOf(document.activeElement as HTMLAnchorElement);
        const next = e.key === 'ArrowDown'
          ? items[(idx + 1) % items.length]
          : items[(idx - 1 + items.length) % items.length];
        next?.focus();
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-download-dd]').forEach(initDropdown);
</script>
