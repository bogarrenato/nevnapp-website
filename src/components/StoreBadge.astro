---
/**
 * Reusable App Store / Google Play button.
 *
 * Two-line layout in the spirit of the official badges, but drawn in our own
 * theme colours (the official artwork may not be recoloured): light pill on
 * the dark theme, dark pill on the light theme.
 *
 * a11y notes:
 *  - The glyph is decorative; the visible text already names the store
 *  - `aria-label` describes the destination for screen readers
 */
import StoreIcon from './StoreIcon.astro';
import type { Lang } from '../i18n/strings';

interface Props {
  store: 'apple' | 'google';
  href: string;
  lang: Lang;
  /** Extra classes, e.g. `w-full` when two badges share a grid row. */
  class?: string;
}
const { store, href, lang, class: className = '' } = Astro.props;

const labelByLang = {
  apple: { hu: 'Letöltés App Store-ból', en: 'Download on the App Store' },
  google: { hu: 'Letöltés Google Play-ről', en: 'Get it on Google Play' },
} as const;

const lineByLang = {
  hu: 'Letöltés',
  en: 'Get it on',
} as const;

const storeName = store === 'apple' ? 'App Store' : 'Google Play';
const label = labelByLang[store][lang];
---

<a href={href} rel="noopener" aria-label={label} class:list={['nx-store', className]}>
  <StoreIcon store={store} class="size-6 shrink-0" />
  <span>
    <small>{lineByLang[lang]}</small>
    <strong>{storeName}</strong>
  </span>
</a>
