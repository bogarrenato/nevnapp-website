---
/**
 * Dynamic route — one page per calendar day (MM-DD).
 * URL: /day/05-25 → "Május 25. névnap"
 * 366 pages total, each one targets "{month} {day} névnap" queries.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { strings } from '../../i18n/strings';
import { getEntryByDate } from '../../lib/names';
import {
  SEO_IDS,
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildItemListSchema,
  buildWebPageSchema,
} from '../../lib/seo';

// NOTE: arrow functions declared at the top of the frontmatter are NOT
// visible inside `getStaticPaths` — that function runs in a separate
// module context. Helpers it needs must be inlined or defined within.
export function getStaticPaths() {
  const pad = (n: number) => String(n).padStart(2, '0');
  const paths = [];
  for (let month = 1; month <= 12; month++) {
    const daysInMonth = new Date(2024, month, 0).getDate();
    for (let day = 1; day <= daysInMonth; day++) {
      paths.push({
        params: { date: `${pad(month)}-${pad(day)}` },
        props: { month, day },
      });
    }
  }
  return paths;
}

const monthsPadded = (m: number) => String(m).padStart(2, '0');

const { month, day } = Astro.props as { month: number; day: number };
const t = strings.hu;
const entry = getEntryByDate(month, day);
const dateLabel = `${t.months[month - 1]} ${day}.`;
const primary = entry?.primary ?? [];
const secondary = entry?.secondary ?? [];
const allNamesForDay = [...primary, ...secondary];
const pagePath = `/day/${monthsPadded(month)}-${monthsPadded(day)}`;

const title = primary.length
  ? `${dateLabel} névnap: ${primary.join(', ')} | ${t.brand}`
  : `${dateLabel} névnap | ${t.brand}`;

const description = primary.length
  ? `${dateLabel} ${primary.join(' és ')} névnapja. Jelentés, eredet, köszöntők és napi értesítések a NévnapTárX appal.`
  : `${dateLabel} névnap a magyar naptár szerint. Töltsd le a NévnapTárX appot iOS-re és Androidra.`;

const directAnswer = primary.length
  ? `${dateLabel} névnapja: ${primary.join(' és ')}.`
  : `${dateLabel} napján nincs kiemelt névnap az adatbázisban.`;

const secondaryAnswer = secondary.length
  ? `További nevek ezen a napon: ${secondary.join(', ')}.`
  : 'Ezen a napon nincs további név felsorolva.';

const faqEntries = [
  {
    q: `Kinek van névnapja ${dateLabel.toLowerCase()}?`,
    a: `${directAnswer} ${secondaryAnswer}`,
  },
  {
    q: `Hol találok részleteket a ${dateLabel.toLowerCase()} névnapos nevekről?`,
    a: allNamesForDay.length
      ? `A névjelentések és köszöntők a névoldalakon érhetők el: ${allNamesForDay.join(', ')}.`
      : 'A teljes magyar névnap-naptár a /calendar oldalon böngészhető.',
  },
];

const jsonLd = [
  buildWebPageSchema({
    path: pagePath,
    name: title,
    description,
    about: { '@id': SEO_IDS.namedayDataset },
  }),
  buildBreadcrumbSchema([
    { name: t.brand, path: '/' },
    { name: t.nav.calendar, path: '/calendar' },
    { name: dateLabel, path: pagePath },
  ]),
  buildFaqSchema(faqEntries),
  allNamesForDay.length
    ? buildItemListSchema({
        name: `${dateLabel} névnapos nevek`,
        path: pagePath,
        items: allNamesForDay.map((name) => ({
          name,
          path: `/name/${encodeURIComponent(name)}`,
        })),
      })
    : null,
].filter(Boolean) as object[];
---

<BaseLayout
  lang="hu"
  title={title}
  description={description}
  jsonLd={jsonLd}
  robots="noindex,follow"
  hideDownloadStrip
>
  <article class="container mx-auto px-6 max-w-3xl pt-3 lg:pt-10">
    <nav class="nx-crumbs" aria-label={t.dayPage.breadcrumbAria}>
      <ol>
        <li><a href="/">{t.brand}</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/calendar">{t.nav.calendar}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{dateLabel}</li>
      </ol>
    </nav>

    <header class="mt-4 lg:mt-6">
      <p class="nx-eyebrow text-nx-accent nx-rise">{t.dayPage.eyebrow}</p>
      <h1 class="mt-3 nx-page-title nx-rise" style="--i:1">
        <span class="text-nx-accent whitespace-nowrap"><time datetime={`--${monthsPadded(month)}-${monthsPadded(day)}`}>{dateLabel}</time></span> névnap
      </h1>
    </header>

    <section class="mt-8 nx-answer nx-rise" style="--i:2" aria-labelledby="quick-answer-heading">
      <h2 id="quick-answer-heading" class="nx-eyebrow font-body text-nx-accent-ink">Rövid válasz</h2>
      <p class="mt-3 text-lg font-semibold text-nx-ink">{directAnswer}</p>
      <p class="mt-2 text-nx-muted leading-relaxed">{secondaryAnswer}</p>
    </section>

    {primary.length ? (
      <section class="mt-6 nx-card p-6 sm:p-9" aria-labelledby="primary-heading" data-reveal>
        <p class="nx-eyebrow text-nx-subtle">{t.dayPage.primary}</p>
        <h2 id="primary-heading" class="mt-3 font-extrabold text-[clamp(2.25rem,8vw,3.5rem)] leading-none tracking-[-0.035em] text-balance">{primary.join(' és ')}</h2>
        <ul class="mt-6 flex flex-wrap gap-2 list-none">
          {primary.map((name) => (
            <li>
              <a
                href={`/name/${encodeURIComponent(name)}`}
                class="group nx-chip nx-chip-on gap-2 font-semibold"
                aria-label={`${name} név részletei`}
              >
                {name}
                <svg class="size-4 transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <section class="mt-6 nx-card p-6 sm:p-9" aria-label={t.dayPage.noNameday} data-reveal>
        <p class="text-nx-muted">{t.dayPage.noNameday}</p>
      </section>
    )}

    {secondary.length > 0 && (
      <section class="mt-4 nx-card p-5 sm:p-7" aria-labelledby="secondary-heading" data-reveal>
        <h3 id="secondary-heading" class="nx-eyebrow font-body text-nx-subtle mb-4">
          {t.dayPage.secondary}
        </h3>
        <ul class="flex flex-wrap gap-2 list-none">
          {secondary.map((n) => (
            <li>
              <a href={`/name/${encodeURIComponent(n)}`} class="nx-chip">{n}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-14 lg:mt-20" aria-labelledby="day-faq-heading" data-reveal>
      <h2 id="day-faq-heading" class="nx-h2">
        Gyakori kérdések — {dateLabel} névnap
      </h2>
      <dl class="mt-6 nx-faq">
        {faqEntries.map((entry) => (
          <div>
            <dt>{entry.q}</dt>
            <dd>{entry.a}</dd>
          </div>
        ))}
      </dl>
    </section>
  </article>
</BaseLayout>
