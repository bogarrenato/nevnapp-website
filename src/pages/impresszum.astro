---
import BaseLayout from '../layouts/BaseLayout.astro';
import { strings } from '../i18n/strings';
const t = strings.hu;
---
<BaseLayout lang="hu" title={`Impresszum | ${t.brand}`} description="A nevnap.app és a NévnapTárX üzemeltetőjének adatai.">
  <article class="container mx-auto px-6 max-w-3xl pt-3 lg:pt-10">
    <nav class="nx-crumbs" aria-label="Morzsamenü">
      <ol><li><a href="/">{t.brand}</a></li><li aria-hidden="true">›</li><li aria-current="page">Impresszum</li></ol>
    </nav>
    <h1 class="mt-6 nx-page-title nx-page-title--sm nx-rise">Impresszum</h1>

    <section class="mt-10 space-y-6 text-nx-muted leading-relaxed">
      <div>
        <h2 class="text-2xl font-bold text-nx-ink">Üzemeltető</h2>
        <p class="mt-2"><strong>Bogár Renátó</strong> egyéni magánszemély</p>
        <p>Ország: Magyarország</p>
        <p>Email: <a href="mailto:bogarrenato@gmail.com" class="text-nx-accent underline">bogarrenato@gmail.com</a></p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-nx-ink">A szolgáltatás</h2>
        <p class="mt-2">A nevnap.app weboldal és a NévnapTárX mobilalkalmazás magyar névnapok, név-jelentések és kapcsolódó tartalmak megosztására szolgáló ingyenes információs platform.</p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-nx-ink">Tárhely-szolgáltató</h2>
        <p class="mt-2"><strong>Cloudflare, Inc.</strong></p>
        <address class="not-italic">101 Townsend Street, San Francisco, CA 94107, USA</address>
        <p>Web: <a href="https://www.cloudflare.com" target="_blank" rel="noopener" class="text-nx-accent underline">cloudflare.com</a></p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-nx-ink">Mobil alkalmazás disztribúció</h2>
        <p class="mt-2">iOS — Apple Inc. (App Store)<br/>Android — Google LLC (Google Play)</p>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-nx-ink">További tájékoztatók</h2>
        <ul class="mt-2 list-disc list-inside space-y-1">
          <li><a href="/privacy" class="text-nx-accent underline">Adatvédelmi tájékoztató</a></li>
          <li><a href="/cookies" class="text-nx-accent underline">Süti szabályzat</a></li>
          <li><a href="/terms" class="text-nx-accent underline">Felhasználási feltételek</a></li>
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>
