---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { strings, interpolate } from '../../i18n/strings';
import { getCollection } from 'astro:content';
import { SEO_IDS, buildBreadcrumbSchema, buildWebPageSchema } from '../../lib/seo';

const t = strings.hu;
const posts = (await getCollection('blog', ({ data }) => data.lang === 'hu'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = `${t.blog.heading} | ${t.brand}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': 'https://nevnap.app/blog#blog',
  name: t.blog.heading,
  description: t.blog.subtitle,
  url: 'https://nevnap.app/blog',
  inLanguage: 'hu-HU',
  publisher: { '@id': SEO_IDS.organization },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    datePublished: p.data.pubDate.toISOString(),
    url: `https://nevnap.app/blog/${p.id}`,
  })),
};

const pageJsonLd = [
  buildWebPageSchema({
    path: '/blog',
    name: title,
    description: t.blog.subtitle,
    type: 'CollectionPage',
    mainEntity: { '@id': 'https://nevnap.app/blog#blog' },
  }),
  buildBreadcrumbSchema([
    { name: t.brand, path: '/' },
    { name: t.blog.title, path: '/blog' },
  ]),
  jsonLd,
];

const fmtDate = (d: Date) => `${d.getFullYear()}. ${t.months[d.getMonth()]} ${d.getDate()}.`;
---
<BaseLayout lang="hu" title={title} description={t.blog.subtitle} jsonLd={pageJsonLd}>
  <article class="container mx-auto px-6 max-w-5xl pt-3 lg:pt-10">
    <nav class="nx-crumbs" aria-label="Morzsamenü">
      <ol><li><a href="/">{t.brand}</a></li><li aria-hidden="true">›</li><li aria-current="page">{t.blog.title}</li></ol>
    </nav>

    <header class="mt-4 lg:mt-6 max-w-3xl">
      <h1 class="nx-page-title nx-rise">{t.blog.heading}</h1>
      <p class="mt-4 nx-lead nx-rise" style="--i:1">{t.blog.subtitle}</p>
    </header>

    <ul class="mt-10 grid sm:grid-cols-2 gap-4 lg:gap-5 list-none">
      {posts.map((p) => (
        <li data-reveal>
          <a href={`/blog/${p.id}`} class="group nx-tile h-full gap-3 p-6 sm:p-7 rounded-[1.5rem]">
            <p class="nx-eyebrow text-xs text-nx-accent">
              {interpolate(t.blog.readingTime, { min: String(p.data.readingMinutes) })}
            </p>
            <h2 class="text-[1.375rem] md:text-2xl font-bold tracking-tight leading-[1.15] text-balance">{p.data.title}</h2>
            <p class="text-nx-muted text-[0.9375rem] leading-relaxed">{p.data.description}</p>
            <p class="mt-auto pt-3 flex items-center justify-between gap-3 text-[0.8125rem] text-nx-subtle">
              <span>{fmtDate(p.data.pubDate)}</span>
              <span class="inline-flex items-center gap-1.5 font-semibold text-nx-accent-ink">{t.blog.readMore} <svg class="size-4 transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </p>
          </a>
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>
