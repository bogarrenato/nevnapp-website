---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { strings, interpolate, SITE_URL } from '../../i18n/strings';
import { getCollection, render } from 'astro:content';
import { SEO_IDS, buildBreadcrumbSchema, buildWebPageSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => data.lang === 'hu');
  return all.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const t = strings.hu;
const fmtDate = (d: Date) => `${d.getFullYear()}. ${t.months[d.getMonth()].toLocaleLowerCase('hu')} ${d.getDate()}.`;
const pagePath = `/blog/${post.id}`;

const jsonLd = [
  buildWebPageSchema({
    path: pagePath,
    name: post.data.title,
    description: post.data.description,
    mainEntity: { '@id': `${SITE_URL}${pagePath}#article` },
  }),
  buildBreadcrumbSchema([
    { name: t.brand, path: '/' },
    { name: t.blog.title, path: '/blog' },
    { name: post.data.title, path: pagePath },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${SITE_URL}${pagePath}#article`,
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    inLanguage: 'hu-HU',
    isAccessibleForFree: true,
    author: { '@id': SEO_IDS.creator },
    publisher: { '@id': SEO_IDS.organization },
    image: `${SITE_URL}/og-default.png`,
    mainEntityOfPage: { '@id': `${SITE_URL}${pagePath}#webpage` },
    keywords: post.data.tags,
  },
];
---
<BaseLayout lang="hu" title={`${post.data.title} | ${t.brand}`} description={post.data.description} jsonLd={jsonLd} adsEligible>
  <article class="container mx-auto px-6 max-w-3xl pt-3 lg:pt-10">
    <nav class="nx-crumbs" aria-label="Morzsamenü">
      <ol>
        <li><a href="/">{t.brand}</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/blog">{t.blog.title}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page" class="truncate">{post.data.title}</li>
      </ol>
    </nav>

    <header class="mt-4 lg:mt-6">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.8125rem] text-nx-subtle nx-rise">
        <a href="/about" rel="author">Bogár Renátó</a>
        <span aria-hidden="true">•</span>
        <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time>
        {post.data.updatedDate && (
          <>
            <span aria-hidden="true">•</span>
            <span>Frissítve: <time datetime={post.data.updatedDate.toISOString()}>{fmtDate(post.data.updatedDate)}</time></span>
          </>
        )}
        <span aria-hidden="true">•</span>
        <span>{interpolate(t.blog.readingTime, { min: String(post.data.readingMinutes) })}</span>
      </div>
      <h1 class="mt-4 nx-page-title nx-page-title--sm nx-rise" style="--i:1">{post.data.title}</h1>
      <p class="mt-4 nx-lead nx-rise" style="--i:2">{post.data.description}</p>

      {post.data.tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2 list-none">
          {post.data.tags.map((tag: string) => (
            <li>
              <span class="inline-flex items-center h-7 px-3 rounded-full bg-nx-line text-xs font-medium text-nx-muted">#{tag}</span>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="blog-content mt-10">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-nx-line2" data-reveal>
      <p class="mb-4 text-sm leading-relaxed text-nx-muted">
        A cikket a NévnapTárX szerkesztője készítette. Az adatkezelésről, forrásokról és javítási elvekről az
        <a href="/adatbazis" class="text-nx-accent hover:underline">adatbázis és módszertan</a> oldalon olvashatsz.
      </p>
      <a href="/blog" class="inline-flex items-center min-h-11 text-nx-accent hover:underline font-semibold">{t.blog.backToBlog}</a>
    </footer>
  </article>
</BaseLayout>
