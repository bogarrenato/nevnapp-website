---
import BaseLayout from '../layouts/BaseLayout.astro';
import { strings } from '../i18n/strings';
const t = strings.hu;
---
<BaseLayout lang="hu" title={`Kapcsolat | ${t.brand}`} description="Lépj kapcsolatba a NévnapTárX fejlesztőjével." altLangPath="/contact">
  <article class="container mx-auto px-6 max-w-3xl pt-3 lg:pt-10">
    <nav class="nx-crumbs" aria-label="Morzsamenü">
      <ol><li><a href="/">{t.brand}</a></li><li aria-hidden="true">›</li><li aria-current="page">Kapcsolat</li></ol>
    </nav>
    <h1 class="mt-6 nx-page-title nx-page-title--sm nx-rise">Kapcsolat</h1>
    <p class="mt-4 text-lg text-nx-muted">Visszajelzések, kérdések, együttműködés — szívesen várjuk!</p>

    <section class="mt-10 grid sm:grid-cols-2 gap-3 lg:gap-4">
      <div class="nx-card p-6" data-reveal>
        <p class="nx-eyebrow text-xs text-nx-subtle flex items-center gap-2"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1z"/><path d="m3.5 7 8.5 6 8.5-6"/></svg> Email</p>
        <p class="mt-2 text-lg font-bold break-words"><a href="mailto:bogarrenato@gmail.com" class="inline-flex items-center min-h-11 text-nx-accent underline underline-offset-4">bogarrenato@gmail.com</a></p>
        <p class="mt-2 text-sm text-nx-muted">Minden ügyben — visszajelzés, együttműködés, hibajelentés.</p>
      </div>
      <div class="nx-card p-6" data-reveal>
        <p class="nx-eyebrow text-xs text-nx-amber flex items-center gap-2"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9z"/><path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3v2.5M12 3v2.5"/></svg> Támogatás</p>
        <p class="mt-2 text-lg font-bold break-words"><a href="https://ko-fi.com/bogarrenato" target="_blank" rel="noopener" class="inline-flex items-center min-h-11 text-nx-accent underline underline-offset-4">ko-fi.com/bogarrenato</a></p>
        <p class="mt-2 text-sm text-nx-muted">Egy kávé árával támogasd a fejlesztést.</p>
      </div>
      <div class="nx-card p-6" data-reveal>
        <p class="nx-eyebrow text-xs text-nx-subtle flex items-center gap-2"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 18V5l11-2v13"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/></svg> TikTok</p>
        <p class="mt-2 text-lg font-bold break-words"><a href="https://www.tiktok.com/@nvnaptrx" target="_blank" rel="noopener" class="inline-flex items-center min-h-11 text-nx-accent underline underline-offset-4">@nvnaptrx</a></p>
      </div>
      <div class="nx-card p-6" data-reveal>
        <p class="nx-eyebrow text-xs text-nx-subtle flex items-center gap-2"><svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg> Instagram</p>
        <p class="mt-2 text-lg font-bold break-words"><a href="https://www.instagram.com/nevnaptarx" target="_blank" rel="noopener" class="inline-flex items-center min-h-11 text-nx-accent underline underline-offset-4">@nevnaptarx</a></p>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold">Válaszadási idő</h2>
      <p class="mt-2 text-nx-muted">Általában 1-3 munkanapon belül válaszolunk. Hétvégén és ünnepnapokon hosszabb is lehet.</p>
    </section>
  </article>
</BaseLayout>
