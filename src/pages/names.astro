---
/**
 * All-names index page. Lists every name grouped by initial letter,
 * each linking to /name/[name]. SEO-rich (lots of internal links).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { strings, interpolate } from '../i18n/strings';
import { getAllNames, normalize } from '../lib/names';
import {
  SEO_IDS,
  buildBreadcrumbSchema,
  buildDefinedTermSetSchema,
  buildNamedayDatasetSchema,
  buildWebPageSchema,
} from '../lib/seo';

const t = strings.hu;
const names = getAllNames();

const groups = new Map<string, string[]>();
for (const name of names) {
  const letter = normalize(name)[0].toUpperCase();
  if (!groups.has(letter)) groups.set(letter, []);
  groups.get(letter)!.push(name);
}
const letters = Array.from(groups.keys()).sort((a, b) => a.localeCompare(b, 'hu'));

const title = `${interpolate(t.namesPage.title, { count: String(names.length) })} | ${t.brand}`;
const description = interpolate(t.namesPage.description, { count: String(names.length) });

const jsonLd = [
  buildWebPageSchema({
    path: '/names',
    name: title,
    description,
    type: 'CollectionPage',
    mainEntity: { '@id': SEO_IDS.nameTermSet },
    about: { '@id': SEO_IDS.namedayDataset },
  }),
  buildBreadcrumbSchema([
    { name: t.brand, path: '/' },
    { name: t.namesPage.heading, path: '/names' },
  ]),
  buildNamedayDatasetSchema(names.length),
  buildDefinedTermSetSchema(names.length),
];
---

<BaseLayout lang="hu" title={title} description={description} jsonLd={jsonLd}>
  <section class="container mx-auto px-6 pt-6 lg:pt-14">
    <header class="max-w-3xl">
      <p class="nx-eyebrow text-nx-accent nx-rise">Névszótár</p>
      <h1 class="mt-3 nx-page-title nx-rise" style="--i:1">{t.namesPage.heading}</h1>
      <p class="mt-4 nx-lead nx-rise" style="--i:2">
        {interpolate(t.namesPage.subtitle, { count: String(names.length) })}
      </p>
    </header>

    <section class="mt-8 nx-answer max-w-3xl nx-rise" style="--i:3" aria-labelledby="names-summary-heading">
      <h2 id="names-summary-heading" class="nx-eyebrow font-body text-nx-accent-ink">
        Adatbázis összefoglaló
      </h2>
      <p class="mt-3 text-nx-muted leading-relaxed">
        A NévnapTárX naptárában szereplő {names.length} keresztnevet rendezzük itt A-tól Z-ig. A kapcsolódó oldalakon megtalálod a névnap dátumát, az elérhető rövid jelentést és köszöntőötleteket; a még hiányzó jelentéseket külön jelezzük.
      </p>
    </section>

    <nav class="nx-jump mt-8" aria-label="Ugrás betű szerint" data-jump>
      <ul>
        {letters.map((l) => (
          <li>
            <a href={`#letter-${l}`} aria-label={`Ugrás a ${l} betűs nevekre`}>{l}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-10 flex flex-col gap-10 lg:gap-12">
      {letters.map((l) => (
        <section id={`letter-${l}`} class="scroll-mt-16 grid gap-x-8 gap-y-4 lg:grid-cols-[5rem_minmax(0,1fr)]" aria-labelledby={`letter-${l}-heading`} data-jump-section>
          <h2 id={`letter-${l}-heading`} class="font-extrabold text-5xl lg:text-6xl leading-none tracking-tighter text-nx-accent lg:sticky lg:top-40 self-start">{l}</h2>
          <ul class="flex flex-wrap gap-2 list-none">
            {groups.get(l)!.map((name) => (
              <li>
                <a href={`/name/${encodeURIComponent(name)}`} class="nx-chip-sm">{name}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
