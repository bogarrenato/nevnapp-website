---
/**
 * Dynamic route — one reference page per Hungarian first name.
 * URL: /name/Anna  /name/Mirkó  /name/Eszter ...
 *
 * Build-time generated name reference pages. They remain available for users
 * but are kept out of Search until they pass the editorial quality gate.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { strings, interpolate, huArticle } from '../../i18n/strings';
import DownloadDropdown from '../../components/DownloadDropdown.astro';
import {
  getAllNames,
  getDatesForName,
  getDisplayMeaning,
  getRelatedNames,
  isPrimary,
} from '../../lib/names';
import { getGreetings, KIND_LABELS_HU } from '../../lib/greetings';
import {
  SEO_IDS,
  absoluteUrl,
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildWebPageSchema,
} from '../../lib/seo';

export function getStaticPaths() {
  return getAllNames().map((name) => ({
    params: { name },
    props: { name },
  }));
}

const { name } = Astro.props as { name: string };
const t = strings.hu;
const article = huArticle(name);
const articleLower = article.toLocaleLowerCase('hu');
const dates = getDatesForName(name);
const meaning = getDisplayMeaning(name);
const related = getRelatedNames(name);

const datesLabel = dates
  .map((e) => `${t.monthsShort[e.month - 1]} ${e.day}.`)
  .join(', ');

const title = `${name} névnap, jelentése${datesLabel ? ` — ${datesLabel}` : ''} | ${t.brand}`;
const description = meaning
  ? `${meaning.slice(0, 150)}${meaning.length > 150 ? '…' : ''}`
  : `Mikor van ${name} névnapja? Eredet, jelentés és modern névnap-naptár app a NévnapTárX-tól.`;

const greetings = getGreetings(name, 'hu', 8);
const pagePath = `/name/${encodeURIComponent(name)}`;

const datesText = dates.length
  ? dates.map((d) => `${t.months[d.month - 1]} ${d.day}`).join(', ')
  : '';

const namedayAnswer = dates.length
  ? `${name} névnapja: ${datesText}.`
  : `${name} jelenleg nem szerepel külön névnapként a NévnapTárX magyar névnap-adatbázisában.`;

const meaningAnswer = meaning
  ? meaning
  : interpolate(t.namePage.noMeaning, { name, article });

const faqEntries: Array<{ q: string; a: string }> = [
  {
    q: interpolate(t.namePage.faqQ1, { name }),
    a: dates.length === 0
      ? interpolate(t.namePage.faqA1None, { name })
      : interpolate(dates.length === 1 ? t.namePage.faqA1Single : t.namePage.faqA1Multi, { name, dates: datesText }),
  },
  {
    q: interpolate(t.namePage.faqQ2, { name, article, articleLower }),
    a: meaning
      ? interpolate(t.namePage.faqA2WithMeaning, { meaning })
      : interpolate(t.namePage.faqA2NoMeaning, { name, article }),
  },
  {
    q: interpolate(t.namePage.faqQ3, { name, article }),
    a: interpolate(t.namePage.faqA3, { name, article }),
  },
];

const jsonLd = [
  buildWebPageSchema({
    path: pagePath,
    name: title,
    description,
    mainEntity: { '@id': `${absoluteUrl(pagePath)}#defined-term` },
    about: [
      { '@id': SEO_IDS.nameTermSet },
      { '@id': SEO_IDS.namedayDataset },
    ],
  }),
  buildBreadcrumbSchema([
    { name: t.brand, path: '/' },
    { name: t.namePage.breadcrumbNames, path: '/names' },
    { name, path: pagePath },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    '@id': `${absoluteUrl(pagePath)}#defined-term`,
    name,
    description: meaning ?? namedayAnswer,
    url: absoluteUrl(pagePath),
    inDefinedTermSet: { '@id': SEO_IDS.nameTermSet },
    subjectOf: { '@id': `${absoluteUrl(pagePath)}#webpage` },
  },
  buildFaqSchema(faqEntries),
].filter(Boolean) as object[];
---

<BaseLayout
  lang="hu"
  title={title}
  description={description}
  jsonLd={jsonLd}
  robots="noindex,follow"
  hideDownloadStrip
>
  <article class="container mx-auto px-6 max-w-3xl pt-3 lg:pt-10">
    <nav class="nx-crumbs" aria-label={t.namePage.breadcrumbAria}>
      <ol>
        <li><a href="/">{t.brand}</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/names">{t.namePage.breadcrumbNames}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">{name}</li>
      </ol>
    </nav>

    <header class="mt-4 lg:mt-6">
      <p class="nx-eyebrow text-nx-accent nx-rise">{t.namePage.eyebrow}</p>
      <h1 class="mt-3 nx-page-title text-nx-accent nx-rise" style="--i:1">{name}</h1>
      <p class="mt-4 nx-lead nx-rise" style="--i:2">
        {interpolate(t.namePage.heading, { name })}
      </p>
    </header>

    <section class="mt-8 nx-answer nx-rise" style="--i:3" aria-labelledby="quick-answer-heading">
      <h2 id="quick-answer-heading" class="nx-eyebrow font-body text-nx-accent-ink">
        Rövid válasz
      </h2>
      <p class="mt-3 text-lg font-semibold text-nx-ink">{namedayAnswer}</p>
      <p class="mt-2 text-nx-muted leading-relaxed">{meaningAnswer}</p>
    </section>

    <section class="mt-6 nx-card p-5 sm:p-7" aria-labelledby="dates-heading" data-reveal>
      <h2 id="dates-heading" class="nx-eyebrow font-body text-nx-subtle">
        {interpolate(t.namePage.datesHeading, { name })}
      </h2>
      {dates.length ? (
        <ul class="mt-4 flex flex-wrap gap-2 list-none">
          {dates.map((d) => {
            const dayPadded = String(d.day).padStart(2, '0');
            const monthPadded = String(d.month).padStart(2, '0');
            const dateLabel = `${t.months[d.month - 1]} ${d.day}.`;
            return (
              <li>
                <a
                  href={`/day/${monthPadded}-${dayPadded}`}
                  class:list={['nx-chip gap-2 font-semibold', isPrimary(name, d) && 'nx-chip-on']}
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/>
                  </svg>
                  <time datetime={`--${monthPadded}-${dayPadded}`}>{dateLabel}</time>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="mt-3 text-nx-muted">{t.namePage.noDates}</p>
      )}
    </section>

    <section class="mt-12 lg:mt-14" aria-labelledby="meaning-heading" data-reveal>
      <h2 id="meaning-heading" class="nx-h2">
        {interpolate(t.namePage.meaningHeading, { name, article })}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-nx-muted" lang="hu">
        {meaning ?? interpolate(t.namePage.noMeaning, { name, article })}
      </p>
    </section>

    <aside class="mt-10" data-reveal>
      <DownloadDropdown
        lang="hu"
        variant="cta"
        id={`name-greeting-${name}`}
        label={interpolate(t.namePage.sendGreeting, { name })}
      />
    </aside>

    {/* Köszöntők szekció — SEO long-tail keyword target */}
    <section class="mt-14 lg:mt-20" aria-labelledby="greetings-heading">
      <div data-reveal>
        <h2 id="greetings-heading" class="nx-h2">
          {interpolate(t.namePage.greetingsHeading, { name })}
        </h2>
        <p class="mt-3 text-nx-muted">
          {interpolate(t.namePage.greetingsIntro, { name })}
        </p>
      </div>
      <ul class="mt-6 flex flex-col gap-3 list-none" lang="hu">
        {greetings.map((g) => (
          <li class="nx-card p-5 transition-colors duration-300 hover:border-nx-accent-line" data-reveal>
            <div class="flex items-center justify-between gap-3">
              <span class="nx-eyebrow text-xs text-nx-accent">
                {KIND_LABELS_HU[g.kind]}
              </span>
              <button
                type="button"
                class="copy-btn -my-2 -mr-2 inline-flex items-center gap-1.5 min-h-11 px-3 rounded-full text-[0.8125rem] font-semibold text-nx-muted hover:text-nx-ink hover:bg-nx-line transition-colors cursor-pointer"
                data-copy-text={g.text}
                data-copied-label={t.namePage.copied.replace('✓', '').trim()}
                aria-label={`${t.namePage.copyGreeting} — ${KIND_LABELS_HU[g.kind]}`}
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15"/>
                </svg>
                <span data-copy-label>{t.namePage.copyGreeting}</span>
              </button>
            </div>
            <p class="mt-2 text-base md:text-lg leading-relaxed whitespace-pre-line text-nx-ink">
              {g.text}
            </p>
          </li>
        ))}
      </ul>
    </section>

    {/* FAQ szekció + FAQPage schema (a frontmatterben már része a jsonLd-nek) */}
    <section class="mt-14 lg:mt-20" aria-labelledby="faq-heading" data-reveal>
      <h2 id="faq-heading" class="nx-h2">
        {interpolate(t.namePage.faqHeading, { name })}
      </h2>
      <dl class="mt-6 nx-faq">
        {faqEntries.map((f) => (
          <div>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>

    {related.length > 0 && (
      <section class="mt-14 lg:mt-20" aria-labelledby="related-heading" data-reveal>
        <h2 id="related-heading" class="text-xl md:text-2xl font-bold tracking-tight">{t.namePage.relatedHeading}</h2>
        <ul class="mt-4 flex flex-wrap gap-2 list-none">
          {related.map((r) => (
            <li>
              <a href={`/name/${encodeURIComponent(r)}`} class="nx-chip-sm">{r}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

<script is:inline>
  // Copy a greeting to the clipboard and confirm it on the button for a moment.
  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest('.copy-btn');
    if (!btn) return;
    var text = btn.getAttribute('data-copy-text') || '';
    var label = btn.querySelector('[data-copy-label]');
    if (!text || !label || btn.hasAttribute('data-copied')) return;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text);
    }
    var original = label.textContent;
    label.textContent = btn.getAttribute('data-copied-label') || original;
    btn.setAttribute('data-copied', '');
    setTimeout(function () { label.textContent = original; btn.removeAttribute('data-copied'); }, 1500);
  });
</script>
</BaseLayout>
