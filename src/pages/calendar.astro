---
/**
 * Calendar index page — shows every month with the primary nameday on each day.
 * SEO target: "magyar névnaptár", "{hónap} névnapok".
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { strings } from '../i18n/strings';
import { getAllNames, getBudapestCalendarDate, getEntryByDate, dateKey } from '../lib/names';
import {
  SEO_IDS,
  buildBreadcrumbSchema,
  buildNamedayDatasetSchema,
  buildWebPageSchema,
} from '../lib/seo';

const t = strings.hu;
const calendarYear = getBudapestCalendarDate().year;

const months = Array.from({ length: 12 }, (_, m) => {
  const monthIndex = m + 1;
  const daysInMonth = new Date(Date.UTC(calendarYear, monthIndex, 0)).getUTCDate();
  return {
    index: monthIndex,
    label: t.months[m],
    days: Array.from({ length: daysInMonth }, (_, d) => {
      const day = d + 1;
      const entry = getEntryByDate(monthIndex, day);
      return { day, primary: entry?.primary ?? [], dateKey: dateKey(monthIndex, day) };
    }),
  };
});

const title = `Magyar névnaptár ${calendarYear} — minden névnap egy helyen | ${t.brand}`;
const description = `${calendarYear} teljes magyar névnap-naptára: minden hónap és nap nevei, közvetlen linkkel a részletekhez.`;
const nameCount = getAllNames().length;

const jsonLd = [
  buildWebPageSchema({
    path: '/calendar',
    name: title,
    description,
    type: 'CollectionPage',
    mainEntity: { '@id': SEO_IDS.namedayDataset },
  }),
  buildBreadcrumbSchema([
    { name: t.brand, path: '/' },
    { name: t.calendarPage.heading, path: '/calendar' },
  ]),
  buildNamedayDatasetSchema(nameCount),
];
---

<BaseLayout lang="hu" title={title} description={description} jsonLd={jsonLd}>
  <section class="container mx-auto px-6 pt-6 lg:pt-14">
    <header class="max-w-3xl">
      <p class="nx-eyebrow text-nx-accent nx-rise">{calendarYear}</p>
      <h1 class="mt-3 nx-page-title nx-rise" style="--i:1">{t.calendarPage.heading}</h1>
      <p class="mt-4 nx-lead nx-rise" style="--i:2">
        Minden napra a magyar névnap-naptár szerinti névnap — koppints egy névre a részletekért.
      </p>
    </header>

    <section class="mt-8 nx-answer max-w-3xl nx-rise" style="--i:3" aria-labelledby="calendar-summary-heading">
      <h2 id="calendar-summary-heading" class="nx-eyebrow font-body text-nx-accent-ink">
        Rövid válasz
      </h2>
      <p class="mt-3 text-nx-muted leading-relaxed">
        Ez a {calendarYear}-es magyar névnap-naptár hónapokra és napokra bontva mutatja a névnapokat. A teljes adatbázis {nameCount} külön névalakot kapcsol egy vagy több dátumhoz; a névjelentések lefedettségét és a forrásokat külön dokumentáljuk.
      </p>
    </section>

    <nav class="nx-jump mt-8" aria-label="Ugrás hónap szerint" data-jump>
      <ul>
        {months.map((m) => (
          <li><a href={`#month-${m.index}`}>{m.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {months.map((m) => (
        <article id={`month-${m.index}`} class="nx-card scroll-mt-16 px-5 pt-5 pb-3 sm:px-6 sm:pt-6" aria-labelledby={`month-${m.index}-heading`} data-jump-section data-reveal>
          <h2 id={`month-${m.index}-heading`} class="text-[1.75rem] font-extrabold leading-none tracking-tight">{m.label}</h2>
          <ul class="mt-4 text-[0.9375rem] list-none divide-y divide-nx-line">
            {m.days.map((d) => (
              <li class="flex items-center justify-between gap-3 min-h-10 rounded-lg" data-day={d.dateKey}>
                <a
                  href={`/day/${d.dateKey}`}
                  class="shrink-0 inline-flex items-center min-h-10 w-9 font-display font-bold tabular-nums text-nx-subtle hover:text-nx-accent transition-colors"
                  aria-label={`${m.label} ${d.day}. — napi névnap részletek`}
                >
                  {d.day}.
                </a>
                <span class="text-right flex-1 truncate">
                  {d.primary.length ? d.primary.map((n, i) => (
                    <>
                      <a href={`/name/${encodeURIComponent(n)}`} class="inline-flex items-center min-h-10 font-medium hover:text-nx-accent transition-colors">{n}</a>{i < d.primary.length - 1 && <span aria-hidden="true">, </span>}
                    </>
                  )) : (
                    <span class="text-nx-subtle" aria-label="Nincs névnap">—</span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <script>
    // Mark today's row (Budapest calendar day). Done in the browser so the
    // highlight is right even when the static build is a day old.
    const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Budapest', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
    const key = `${parts.find((p) => p.type === 'month')?.value}-${parts.find((p) => p.type === 'day')?.value}`;
    document.querySelector<HTMLElement>(`[data-day="${key}"]`)?.setAttribute('data-today', '');
  </script>
</BaseLayout>
