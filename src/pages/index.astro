---
/**
 * Hungarian landing page — the SEO crown jewel.
 *
 * Targets: "mai névnap", "magyar névnaptár", "név jelentése" head queries.
 * Inlines today's nameday + meaning so it ranks even before any clicks.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import UpcomingStrip from '../components/UpcomingStrip.astro';
import { strings } from '../i18n/strings';
import { getDailyPage } from '../lib/daily-page';
import { buildNamedayDatasetSchema } from '../lib/seo';

const t = strings.hu;
const daily = getDailyPage('hu');
const { today, allNames, daysInCurrentYear, pageTitle, pageDescription, faqEntries } = daily;

const jsonLd = [
  daily.webPageSchema,
  buildNamedayDatasetSchema(allNames.length),
  daily.faqSchema,
].filter(Boolean) as object[];
---

<BaseLayout
  lang="hu"
  title={pageTitle}
  description={pageDescription}
  altLangPath="/"
  jsonLd={jsonLd}
  adsEligible
>
  <Hero lang="hu" />
  <UpcomingStrip lang="hu" />

  <section class="container mx-auto px-6 mt-20 lg:mt-28 grid gap-x-16 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]" aria-labelledby="direct-answers-heading">
    <div class="lg:sticky lg:top-28 self-start" data-reveal>
      <p class="nx-eyebrow text-nx-accent">Rövid válaszok</p>
      <h2 id="direct-answers-heading" class="nx-h2 mt-3">Mai névnap és magyar névnap-adatbázis</h2>
    </div>
    <div>
      <dl class="flex flex-col border-b border-nx-line2">
        {faqEntries.map((entry, i) => (
          <div class="flex flex-col gap-2 py-5 lg:py-6 border-t border-nx-line2" data-reveal>
            <dt class="text-lg lg:text-[1.1875rem] font-semibold leading-snug">{entry.q}</dt>
            <dd data-daily={i === 0 ? 'answer' : undefined} class="leading-relaxed text-nx-muted">{entry.a}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-5 text-sm leading-relaxed text-nx-subtle" data-reveal>
        Adatforrás: a NévnapTárX tájékoztató jellegű magyar névnap-naptára. Lefedettség és módszertan: <a href="/adatbazis" class="text-nx-accent hover:underline">adatbázis és források</a>. Aktuális nap: <span data-daily="iso">{today.iso}</span>.
      </p>
    </div>
  </section>

  <!-- SEO content block — visible explanatory copy for users and crawlers -->
  <section class="container mx-auto px-6 mt-20 lg:mt-28" aria-labelledby="home-seo-heading">
    <div class="grid gap-x-16 gap-y-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
      <h2 id="home-seo-heading" class="nx-h2" data-reveal>{t.homeSeo.heading}</h2>
      <div class="flex flex-col gap-4 text-[1.0625rem] leading-relaxed text-nx-muted text-pretty" data-reveal>
        <p>{t.homeSeo.p1}</p>
        <p>{t.homeSeo.p2}</p>
      </div>
    </div>

    <div class="mt-9 lg:mt-12 grid sm:grid-cols-3 sm:gap-3 max-sm:rounded-3xl max-sm:border max-sm:border-nx-line max-sm:bg-nx-s1 max-sm:divide-y max-sm:divide-nx-line">
      {[
        { label: String(allNames.length), text: t.homeSeo.statNames, count: true },
        { label: String(daysInCurrentYear), text: t.homeSeo.statDays, count: true, daily: 'year-days' },
        { label: '0 Ft', text: t.homeSeo.statFree, accent: true },
      ].map((stat) => (
        <div
          data-reveal
          class:list={[
            'flex items-baseline justify-between gap-4 px-5 py-[1.125rem] sm:flex-col sm:items-start sm:justify-start sm:gap-1.5 sm:p-7 sm:rounded-3xl sm:border',
            stat.accent ? 'sm:border-nx-accent-line sm:bg-nx-accent-panel' : 'sm:border-nx-line sm:bg-nx-s1',
          ]}
        >
          <p
            data-daily={stat.daily}
            data-countup={stat.count ? '' : undefined}
            class:list={['font-display font-extrabold leading-none tracking-tight tabular-nums text-[2.5rem] sm:text-[clamp(3rem,6vw,5rem)]', stat.accent && 'text-nx-accent']}
          >{stat.label}</p>
          <p class="text-[0.9375rem] sm:text-base text-nx-muted max-sm:text-right">{stat.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Ko-fi Support Section -->
  <section class="container mx-auto px-6 mt-20 lg:mt-28" aria-labelledby="support-heading">
    <div class="flex flex-col lg:flex-row lg:items-center gap-x-10 gap-y-5 p-6 sm:p-10 lg:p-14 rounded-[1.75rem] lg:rounded-[2rem] border border-nx-amber-line bg-nx-amber-panel" data-reveal>
      <div aria-hidden="true" class="shrink-0 size-14 lg:size-[4.5rem] grid place-items-center rounded-[1.125rem] lg:rounded-[1.375rem] border border-nx-amber-line bg-nx-amber-soft text-nx-amber">
        <svg class="size-7 lg:size-[2.125rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9z"/>
          <path d="M17 10h1.5a2.5 2.5 0 0 1 0 5H17"/>
          <path class="nx-steam" d="M8 3v2.5M12 3v2.5"/>
        </svg>
      </div>

      <div class="flex-1 min-w-0 flex flex-col gap-2.5">
        <p class="nx-eyebrow text-nx-amber">{t.support.eyebrow}</p>
        <h2 id="support-heading" class="font-bold text-[1.625rem] lg:text-[2.125rem] leading-[1.12] tracking-tight text-balance">
          {t.support.heading}
        </h2>
        <p class="max-w-[37.5rem] leading-relaxed text-nx-amber-muted text-pretty">
          {t.support.body}
        </p>
      </div>

      <div class="shrink-0 flex flex-col items-stretch lg:items-start gap-2.5 max-lg:mt-2">
        <a
          href="https://ko-fi.com/bogarrenato"
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2.5 h-14 px-6 rounded-full bg-[#ffb95c] hover:bg-[#ffc87f] text-[#1a1206] font-bold shadow-[0_16px_40px_-16px_rgba(255,185,92,0.7)] transition-[transform,background-color] duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 active:scale-[0.98]"
        >
          {t.support.cta}
          <svg class="size-[1.125rem] transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
        <p class="text-[0.8125rem] text-nx-amber-muted max-lg:text-center lg:pl-1">{t.support.subtext}</p>
      </div>
    </div>
  </section>

</BaseLayout>
