---
/**
 * English landing page for visitors learning about the Hungarian tradition.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import UpcomingStrip from '../../components/UpcomingStrip.astro';
import { strings } from '../../i18n/strings';
import { getDailyPage } from '../../lib/daily-page';
import { buildNamedayDatasetSchema } from '../../lib/seo';

const t = strings.en;
const daily = getDailyPage('en');
const { today, allNames, pageTitle, faqEntries } = daily;

const jsonLd = [
  daily.webPageSchema,
  buildNamedayDatasetSchema(allNames.length),
  daily.faqSchema,
];
---

<BaseLayout
  lang="en"
  title={pageTitle}
  description={t.description}
  altLangPath="/"
  jsonLd={jsonLd}
>
  <Hero lang="en" />
  <UpcomingStrip lang="en" />

  <section class="container mx-auto px-6 mt-20 lg:mt-28 grid gap-x-16 gap-y-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]" aria-labelledby="direct-answers-heading">
    <div class="lg:sticky lg:top-28 self-start" data-reveal>
      <p class="nx-eyebrow text-nx-accent">Quick answers</p>
      <h2 id="direct-answers-heading" class="nx-h2 mt-3">Today's Hungarian nameday</h2>
    </div>
    <div>
      <dl class="flex flex-col border-b border-nx-line2">
        {faqEntries.map((entry, i) => (
          <div class="flex flex-col gap-2 py-5 lg:py-6 border-t border-nx-line2" data-reveal>
            <dt class="text-lg lg:text-[1.1875rem] font-semibold leading-snug">{entry.q}</dt>
            <dd data-daily={i === 0 ? 'answer' : undefined} class="leading-relaxed text-nx-muted">{entry.a}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-5 text-sm leading-relaxed text-nx-subtle" data-reveal>
        Current date: <span data-daily="iso">{today.iso}</span>, Europe/Budapest.
      </p>
    </div>
  </section>

  <section class="container mx-auto px-6 mt-20 lg:mt-28 grid gap-x-16 gap-y-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]" aria-labelledby="home-seo-heading">
    <h2 id="home-seo-heading" class="nx-h2" data-reveal>What's a Hungarian nameday?</h2>
    <div class="flex flex-col gap-4 text-[1.0625rem] leading-relaxed text-nx-muted text-pretty [&_strong]:text-nx-ink" data-reveal>
      <p>
        In Hungary, every day of the year is associated with one or two given names —
        a <strong>nameday</strong> (<em>névnap</em>). Family and friends celebrate the
        person whose name matches the day with a small gift, a call, or a sweet message.
      </p>
      <p>
        <strong>NévnapTárX</strong> is a modern nameday calendar app covering
        <strong>{allNames.length} distinct name forms</strong>, with hundreds of short
        name meanings and optional daily reminders on iOS and Android.
      </p>
    </div>
  </section>
</BaseLayout>
