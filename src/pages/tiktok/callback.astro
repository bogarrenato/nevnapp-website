---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { strings } from '../../i18n/strings';

const t = strings.hu;
---

<BaseLayout
  lang="hu"
  title={`TikTok kapcsolódás | ${t.brand}`}
  description="TikTok fejlesztői engedélyezési visszatérési oldal a NévnapTárX automatizált videós posztolásához."
  canonical="https://nevnap.app/tiktok/callback"
  robots="noindex,nofollow"
  hideDownloadStrip
>
  <main class="container mx-auto px-6 max-w-3xl pt-3 lg:pt-10">
    <nav class="nx-crumbs" aria-label="Morzsamenü">
      <ol>
        <li><a href="/">{t.brand}</a></li>
        <li aria-hidden="true">›</li>
        <li aria-current="page">TikTok kapcsolódás</li>
      </ol>
    </nav>

    <h1 class="mt-6 nx-page-title nx-page-title--sm nx-rise">
      TikTok kapcsolódás
    </h1>

    <section class="mt-10 rounded-2xl border border-nx-line bg-nx-s1 p-6 md:p-8">
      <p id="status" class="text-nx-muted">
        Engedélyezési adatok betöltése...
      </p>

      <div id="code-panel" class="hidden mt-6">
        <label for="auth-code" class="block text-sm font-semibold text-nx-ink">
          TikTok authorization code
        </label>
        <textarea
          id="auth-code"
          readonly
          rows="4"
          class="mt-2 w-full rounded-xl border border-nx-line2 bg-nx-bg px-3 py-2 font-mono text-sm text-nx-ink"
        ></textarea>
        <button
          id="copy-code"
          type="button"
          class="mt-4 rounded-full bg-nx-fill px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#7d6bff] transition"
        >
          Kód másolása
        </button>
        <p class="mt-4 text-sm text-nx-subtle">
          Ezt a kódot egyszer lehet beváltani TikTok access tokenre és refresh tokenre.
        </p>
      </div>

      <div id="error-panel" class="hidden mt-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">
        <p class="font-semibold">TikTok hiba</p>
        <p id="error-message" class="mt-1"></p>
      </div>
    </section>
  </main>

  <script is:inline>
    const params = new URLSearchParams(window.location.search);
    const code = params.get('code');
    const error = params.get('error');
    const errorDescription = params.get('error_description');
    const status = document.getElementById('status');
    const codePanel = document.getElementById('code-panel');
    const codeField = document.getElementById('auth-code');
    const copyButton = document.getElementById('copy-code');
    const errorPanel = document.getElementById('error-panel');
    const errorMessage = document.getElementById('error-message');

    if (code) {
      status.textContent = 'Sikeres TikTok engedélyezés.';
      codeField.value = code;
      codePanel.classList.remove('hidden');
    } else if (error) {
      status.textContent = 'A TikTok engedélyezés nem sikerült.';
      errorMessage.textContent = errorDescription || error;
      errorPanel.classList.remove('hidden');
    } else {
      status.textContent = 'Nem érkezett TikTok authorization code. Indítsd újra az engedélyezést a TikTok Developer OAuth linken keresztül.';
    }

    copyButton?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(codeField.value);
      copyButton.textContent = 'Kimásolva';
    });
  </script>
</BaseLayout>
