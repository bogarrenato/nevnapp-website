---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="hu"
  title="Az oldal nem található | NévnapTárX"
  description="A kért oldal nem található."
  robots="noindex,nofollow"
  hideDownloadStrip
>
  <section class="container mx-auto px-6 max-w-2xl pt-16 md:pt-28 text-center">
    <p class="font-display font-extrabold text-[clamp(5rem,26vw,9rem)] leading-none tracking-[-0.06em] text-nx-accent nx-rise" aria-hidden="true">404</p>
    <h1 class="mt-4 nx-page-title nx-page-title--sm nx-rise" style="--i:1">
      Ez az oldal nem található
    </h1>
    <p class="mt-5 nx-lead nx-rise" style="--i:2">
      Lehet, hogy a cím elgépelést tartalmaz, vagy az oldal időközben más helyre került.
    </p>
    <p class="mt-2 text-nx-muted" lang="en">
      The page you requested could not be found.
    </p>
    <nav class="mt-8 flex flex-wrap justify-center gap-2.5 nx-rise" style="--i:3" aria-label="Hasznos oldalak">
      <a href="/" class="nx-btn-primary h-12 px-6">Mai névnap</a>
      <a href="/names" class="nx-chip h-12 px-6 font-semibold">Nevek böngészése</a>
      <a href="/blog" class="nx-chip h-12 px-6 font-semibold">Névnap blog</a>
    </nav>
  </section>
</BaseLayout>
